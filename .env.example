CONVERTLABS_TOKEN=
PORT=3000

# Postgres connection string (Neon, provisioned via Vercel's Storage tab).
# Vercel project -> Storage -> your Postgres -> Connect.
DATABASE_URL=

# Public origin of the deployed app, used to build the absolute logo URL inside emailed pay
# statements (src/pay-statement.js). It must be reachable from a recipient's inbox: a statement
# generated on a dev machine would otherwise carry a localhost image URL nobody could load.
# No trailing slash.
PUBLIC_BASE_URL=http://localhost:3000
